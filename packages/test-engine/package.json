{
  "name": "@tsclang/test-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/engine.ts",
  "exports": {
    ".": "./src/engine.ts",
    "./compilers": "./src/compilers/index.ts"
  },
  "bin": {
    "tsclang-test": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "tsx src/tests/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tsclang/compiler": "*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}