{
  "name": "@tsclang/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "tsclang": "./dist/index.js" },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@tsclang/compiler": "workspace:*",
    "@tsclang/pm": "workspace:*",
    "@tsclang/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
