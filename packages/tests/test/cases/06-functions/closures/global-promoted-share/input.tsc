// [R] A top-level primitive referenced by a top-level function is promoted to a
// static global (func-ref scan), and a plain arrow over the SAME global
// references it directly (#298 s1): bump() and f() share one cell — TS-true
// (prints 1 2, matching TypeScript module-scope semantics).
let counter = 0;
function bump(): void { counter = counter + 1; }
const f = (): number => { counter = counter + 1; return counter; };
console.log(f());
bump();
console.log(counter);
