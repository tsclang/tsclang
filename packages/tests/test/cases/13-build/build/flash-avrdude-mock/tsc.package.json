{
  "name": "flashmock",
  "version": "0.1.0",
  "type": "executable",
  "main": "main.tsc",
  "builds": {
    "uno": {
      "profile": "avr",
      "mcu": "atmega328p",
      "emit": "flash",
      "toolchain": "avr-gcc",
      "flash": { "programmer": "arduino", "port": "COM3", "baud": 115200 }
    }
  }
}
