const a: i8 = Number.MAX_I8;
const b: i8 = Number.MIN_I8;
const c: i16 = Number.MAX_I16;
const d: i16 = Number.MIN_I16;
const e: i32 = Number.MAX_I32;
const f: i32 = Number.MIN_I32;
const g: i64 = Number.MAX_I64;
const h: i64 = Number.MIN_I64;
const i: u8 = Number.MAX_U8;
const j: u16 = Number.MAX_U16;
const k: u32 = Number.MAX_U32;
const l: u64 = Number.MAX_U64;
const safeMax: i64 = Number.MAX_SAFE_INTEGER;
const safeMin: i64 = Number.MIN_SAFE_INTEGER;
console.log(a, b);
console.log(c, d);
console.log(e, f);
console.log(g, h);
console.log(i, j);
console.log(k, l);
