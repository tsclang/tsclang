{
  "name": "@tsclang/desktop",
  "version": "0.4.0",
  "files": {
    "index.d.tsc": "declare platform {\n    allocator: \"heap\"\n    async: \"libuv\"\n    fpu: true\n    bits: 64\n    usize: \"u64\"\n    defaultNumber: \"f64\"\n    unaligned_access: true\n    os: true\n    posix: true\n    strtoll: true\n}\n",
    "tsc.package.json": "{\n  \"name\": \"@tsclang/desktop\",\n  \"version\": \"0.4.0\",\n  \"type\": \"platform\",\n  \"description\": \"Desktop reference platform: clang build-and-run (isolated clang/LLVM bundles for win/linux/macos-arm64; darwin-x64 -> Xcode CLT; #282: PATH only for pinned toolchains)\",\n  \"platform\": {\n    \"profile\": \"desktop\",\n    \"toolchains\": {\n      \"clang\": {\n        \"version\": \"23.1.5\",\n        \"downloads\": {\n          \"win32-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-desktop/releases/download/toolchains-v2/clang-23.1.5-win32-x64.tar.gz\",\n            \"sha256\": \"6b05ceb57ebabdb4d5d21385976a196eba625fa0e30e1c15b91bd3a221ed8b2b\",\n            \"size\": 186\n          },\n          \"linux-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-desktop/releases/download/toolchains-v2/clang-23.1.5-linux-x64.tar.xz\",\n            \"sha256\": \"4ab196902dde81bc42137fbc61b045106370d22fb7511a13072c316bb80c9e3e\",\n            \"size\": 1999\n          },\n          \"darwin-arm64\": {\n            \"url\": \"https://github.com/tsclang/platform-desktop/releases/download/toolchains-v2/clang-23.1.5-darwin-arm64.tar.xz\",\n            \"sha256\": \"61241aba35cbec918eb690870b6a65659d5fc2f0c37a5e2fb1abb5268afc5ddf\",\n            \"size\": 1553\n          }\n        }\n      }\n    },\n    \"builds\": {\n      \"desktop\": { \"profile\": \"desktop\", \"emit\": \"exec\", \"outDir\": \"build/desktop\" }\n    },\n    \"scripts\": {\n      \"start\": \"tsclang build --build desktop\",\n      \"dev\": \"tsclang build --build desktop --watch\"\n    }\n  }\n}\n"
  }
}