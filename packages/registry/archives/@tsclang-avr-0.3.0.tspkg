{
  "name": "@tsclang/avr",
  "version": "0.3.0",
  "files": {
    "index.d.tsc": "declare platform {\n    target: \"avr\"\n    allocator: \"static\"\n    async: \"none\"\n    fpu: false\n    bits: 8\n    usize: \"u16\"\n    defaultNumber: \"i16\"\n    unaligned_access: false\n    os: false\n    posix: false\n    strtoll: false\n    console_uart: true\n    console_baud: 9600\n    toolchain: \"avr-gcc\"\n}\n",
    "tsc.package.json": "{\n  \"name\": \"@tsclang/avr\",\n  \"version\": \"0.3.0\",\n  \"type\": \"platform\",\n  \"description\": \"AVR microcontroller platform: avr-gcc hex/flash + avrdude (system tools first, bundled as fallback)\",\n  \"platform\": {\n    \"profile\": \"avr\",\n    \"toolchains\": {\n      \"avr-gcc\": {\n        \"version\": \"16.1.0\",\n        \"downloads\": {\n          \"win32-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-avr/releases/download/toolchains-v1/avr-gcc-16.1.0-win32-x64.tar.gz\",\n            \"sha256\": \"cce55e54a7af8021c725ecd8a9f3c4400b4293f50f9be0cf6b5c1d6b9d7ff30c\",\n            \"size\": 163\n          },\n          \"linux-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-avr/releases/download/toolchains-v1/avr-gcc-16.1.0-linux-x64.tar.gz\",\n            \"sha256\": \"0e0cab36269faf2424a091c239dae8cad3061c106b8da6915a690edf07bad723\",\n            \"size\": 164\n          },\n          \"darwin-arm64\": {\n            \"url\": \"https://github.com/tsclang/platform-avr/releases/download/toolchains-v1/avr-gcc-16.1.0-darwin-arm64.tar.gz\",\n            \"sha256\": \"12d81f3f93dfa510c6081e291e278e15aca339794dd3b15dfb16ebb6f3fb25e7\",\n            \"size\": 117\n          }\n        }\n      },\n      \"avrdude\": {\n        \"version\": \"8.3\",\n        \"downloads\": {\n          \"win32-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-avr/releases/download/toolchains-v1/avrdude-8.3-win32-x64.tar.gz\",\n            \"sha256\": \"7d53a0461698cceeb2f3542850f0d45d54553c95822855597e842b5a14c0199b\",\n            \"size\": 8\n          },\n          \"linux-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-avr/releases/download/toolchains-v1/avrdude-8.3-linux-x64.tar.gz\",\n            \"sha256\": \"28371f2bf1d22b6908e2ccb8657d3ede061c164012b758cde699b4a38eb11f1c\",\n            \"size\": 4\n          },\n          \"darwin-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-avr/releases/download/toolchains-v1/avrdude-8.3-darwin-x64.tar.gz\",\n            \"sha256\": \"8eb895d0478bc3a5c6baadca6c1e2401332aae0f6b4bfb2271304d124008fe1b\",\n            \"size\": 3\n          },\n          \"darwin-arm64\": {\n            \"url\": \"https://github.com/tsclang/platform-avr/releases/download/toolchains-v1/avrdude-8.3-darwin-arm64.tar.gz\",\n            \"sha256\": \"87cf2911262788f52a4cda361423e427edeb519d4fa9adb5ec50da17fbe2c8e1\",\n            \"size\": 7\n          }\n        }\n      }\n    },\n    \"builds\": {\n      \"avr\": { \"profile\": \"avr\", \"emit\": \"hex\", \"outDir\": \"build/avr\" }\n    },\n    \"scripts\": {\n      \"flash\": \"tsclang build --build avr --emit flash\"\n    }\n  }\n}\n"
  }
}