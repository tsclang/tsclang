{
  "name": "@tsclang/wasm",
  "version": "0.3.0",
  "files": {
    "index.d.tsc": "declare platform {\n    target: \"wasm\"\n    allocator: \"heap\"\n    async: \"none\"\n    fpu: true\n    bits: 32\n    usize: \"u32\"\n    defaultNumber: \"f64\"\n    unaligned_access: true\n    os: false\n    posix: false\n    strtoll: false\n    toolchain: \"emcc\"\n}\n",
    "tsc.package.json": "{\n  \"name\": \"@tsclang/wasm\",\n  \"version\": \"0.3.0\",\n  \"type\": \"platform\",\n  \"description\": \"WebAssembly bare platform (runtime_wasm.h, emscripten): wasm32, no POSIX; emcc ships as a bundle\",\n  \"platform\": {\n    \"profile\": \"wasm\",\n    \"toolchains\": {\n      \"emcc\": {\n        \"version\": \"7.0.0\",\n        \"downloads\": {\n          \"win32-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-wasm/releases/download/toolchains-v1/emcc-7.0.0-win32-x64.tar.gz\",\n            \"sha256\": \"0613c87c9ed2e72c843b7c2e884aeb5885b883a3adfcad5322653690d7b4a78d\",\n            \"size\": 807\n          },\n          \"linux-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-wasm/releases/download/toolchains-v1/emcc-7.0.0-linux-x64.tar.gz\",\n            \"sha256\": \"f9a8346139148bc82877722c3a077e2a11505320595f0fe955414fe7e75e290d\",\n            \"size\": 546,\n            \"note\": \"requires system python3 in PATH (same as upstream emsdk on linux)\"\n          },\n          \"darwin-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-wasm/releases/download/toolchains-v1/emcc-7.0.0-darwin-x64.tar.gz\",\n            \"sha256\": \"e5510a254cabac52c5983fe5359f17dfbb4728557c4d58a10c3e6b1010dbd72e\",\n            \"size\": 545\n          },\n          \"darwin-arm64\": {\n            \"url\": \"https://github.com/tsclang/platform-wasm/releases/download/toolchains-v1/emcc-7.0.0-darwin-arm64.tar.gz\",\n            \"sha256\": \"2ffc5e83d508c9105c0abf1e59e98980234b250542c8a85f613b2a0c15be17bc\",\n            \"size\": 574\n          }\n        }\n      }\n    },\n    \"builds\": {\n      \"wasm\": { \"profile\": \"wasm\", \"emit\": \"wasm\", \"outDir\": \"build/wasm\" }\n    }\n  }\n}\n"
  }
}