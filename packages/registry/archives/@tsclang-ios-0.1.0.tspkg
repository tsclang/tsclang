{
  "name": "@tsclang/ios",
  "version": "0.1.0",
  "files": {
    "index.d.tsc": "declare platform {\n    target: \"ios\"\n    allocator: \"heap\"\n    async: \"none\"\n    fpu: true\n    bits: 64\n    usize: \"u64\"\n    defaultNumber: \"f64\"\n    unaligned_access: true\n    os: true\n    posix: true\n    strtoll: true\n    toolchain: \"clang\"\n}\n",
    "tsc.package.json": "{\n  \"name\": \"@tsclang/ios\",\n  \"version\": \"0.1.0\",\n  \"type\": \"platform\",\n  \"description\": \"Apple iOS platform: Xcode clang via xcrun (macOS-only; simulator binaries run on the host). No toolchain bundle — the Apple SDK is not redistributable, Xcode Command Line Tools ARE the toolchain (instruction mode, darwin-x64 clang precedent)\",\n  \"platform\": {\n    \"profile\": \"ios\",\n    \"builds\": {\n      \"ios-sim\": { \"profile\": \"ios\", \"emit\": \"binary\", \"toolchain\": \"clang\", \"outDir\": \"build/ios-sim\" },\n      \"ios-device\": { \"profile\": \"ios\", \"sdk\": \"iphoneos\", \"emit\": \"binary\", \"toolchain\": \"clang\", \"outDir\": \"build/ios-device\" }\n    },\n    \"scripts\": {\n      \"start\": \"tsclang build --build ios-sim\"\n    }\n  }\n}\n"
  }
}