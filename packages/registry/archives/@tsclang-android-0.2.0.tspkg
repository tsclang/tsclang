{
  "name": "@tsclang/android",
  "version": "0.2.0",
  "files": {
    "index.d.tsc": "declare platform {\n    target: \"android\"\n    allocator: \"heap\"\n    async: \"none\"\n    fpu: true\n    bits: 64\n    usize: \"u64\"\n    defaultNumber: \"f64\"\n    unaligned_access: true\n    os: true\n    posix: true\n    strtoll: true\n    toolchain: \"ndk-clang\"\n}\n",
    "tsc.package.json": "{\n  \"name\": \"@tsclang/android\",\n  \"version\": \"0.2.0\",\n  \"type\": \"platform\",\n  \"description\": \"Android platform (bionic, API 28+ since #287 — libuv posix_spawn floor): NDK clang cross-compile — PIE binary and .so; ndk-clang ships as a repacked official NDK bundle; libuv 1.53.0 static bundle unlocks async (--async libuv, #287)\",\n  \"platform\": {\n    \"profile\": \"android\",\n    \"toolchains\": {\n      \"ndk-clang\": {\n        \"version\": \"30.0.16248370\",\n        \"downloads\": {\n          \"win32-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-android/releases/download/toolchains-v1/ndk-clang-30.0.16248370-win32-x64.tar.gz\",\n            \"sha256\": \"b14a3b04b5e83a74a748646cbb48a51ed39136503f7dc56a1d2729a21499d999\",\n            \"size\": 722\n          },\n          \"linux-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-android/releases/download/toolchains-v1/ndk-clang-30.0.16248370-linux-x64.tar.gz\",\n            \"sha256\": \"977cae2164adca78b9e435d72265c021620c106b2761bd5b4e424e14624f922e\",\n            \"size\": 753\n          },\n          \"darwin-arm64\": {\n            \"url\": \"https://github.com/tsclang/platform-android/releases/download/toolchains-v1/ndk-clang-30.0.16248370-darwin-arm64.tar.gz\",\n            \"sha256\": \"563965de627d3ee4c2d84ac51d08a436950e12971574caeb86fff55ad6bf33e0\",\n            \"size\": 1617\n          }\n        }\n      },\n      \"libuv\": {\n        \"version\": \"1.53.0\",\n        \"downloads\": {\n          \"win32-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-android/releases/download/toolchains-v2/libuv-1.53.0-mobile.tar.gz\",\n            \"sha256\": \"2597ad858657e2e42ceb95a512a399d4dc2f33579b81fbb2e039c737817ba931\",\n            \"size\": 1\n          },\n          \"linux-x64\": {\n            \"url\": \"https://github.com/tsclang/platform-android/releases/download/toolchains-v2/libuv-1.53.0-mobile.tar.gz\",\n            \"sha256\": \"2597ad858657e2e42ceb95a512a399d4dc2f33579b81fbb2e039c737817ba931\",\n            \"size\": 1\n          },\n          \"darwin-arm64\": {\n            \"url\": \"https://github.com/tsclang/platform-android/releases/download/toolchains-v2/libuv-1.53.0-mobile.tar.gz\",\n            \"sha256\": \"2597ad858657e2e42ceb95a512a399d4dc2f33579b81fbb2e039c737817ba931\",\n            \"size\": 1\n          }\n        }\n      }\n    },\n    \"builds\": {\n      \"android\": { \"profile\": \"android\", \"emit\": \"binary\", \"outDir\": \"build/android\" },\n      \"android-so\": { \"profile\": \"android\", \"emit\": \"so\", \"outDir\": \"build/android\" },\n      \"android-async\": { \"profile\": \"android\", \"emit\": \"binary\", \"async\": \"libuv\", \"outDir\": \"build/android-async\" }\n    },\n    \"scripts\": {\n      \"start\": \"tsclang build --build android\"\n    }\n  }\n}\n"
  }
}