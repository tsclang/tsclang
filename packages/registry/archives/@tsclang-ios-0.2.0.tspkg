{
  "name": "@tsclang/ios",
  "version": "0.2.0",
  "files": {
    "index.d.tsc": "declare platform {\n    target: \"ios\"\n    allocator: \"heap\"\n    async: \"none\"\n    fpu: true\n    bits: 64\n    usize: \"u64\"\n    defaultNumber: \"f64\"\n    unaligned_access: true\n    os: true\n    posix: true\n    strtoll: true\n    toolchain: \"clang\"\n}\n",
    "tsc.package.json": "{\n  \"name\": \"@tsclang/ios\",\n  \"version\": \"0.2.0\",\n  \"type\": \"platform\",\n  \"description\": \"Apple iOS platform: Xcode clang via xcrun (macOS-only; simulator binaries run on the host). libuv 1.53.0 static bundle unlocks async (--async libuv, #287); the Apple SDK itself is not redistributable — Xcode Command Line Tools ARE the compiler toolchain (darwin-x64 clang precedent)\",\n  \"platform\": {\n    \"profile\": \"ios\",\n    \"toolchains\": {\n      \"libuv\": {\n        \"version\": \"1.53.0\",\n        \"downloads\": {\n          \"darwin-arm64\": {\n            \"url\": \"https://github.com/tsclang/platform-android/releases/download/toolchains-v2/libuv-1.53.0-mobile.tar.gz\",\n            \"sha256\": \"2597ad858657e2e42ceb95a512a399d4dc2f33579b81fbb2e039c737817ba931\",\n            \"size\": 1\n          }\n        }\n      }\n    },\n    \"builds\": {\n      \"ios-sim\": { \"profile\": \"ios\", \"emit\": \"binary\", \"toolchain\": \"clang\", \"outDir\": \"build/ios-sim\" },\n      \"ios-device\": { \"profile\": \"ios\", \"sdk\": \"iphoneos\", \"emit\": \"binary\", \"toolchain\": \"clang\", \"outDir\": \"build/ios-device\" },\n      \"ios-sim-async\": { \"profile\": \"ios\", \"emit\": \"binary\", \"toolchain\": \"clang\", \"async\": \"libuv\", \"outDir\": \"build/ios-sim-async\" }\n    },\n    \"scripts\": {\n      \"start\": \"tsclang build --build ios-sim\"\n    }\n  }\n}\n"
  }
}