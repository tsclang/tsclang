{
  "name": "@tsclang/desktop",
  "version": "0.1.0",
  "files": {
    "index.d.tsc": "declare platform {\n    allocator: \"heap\"\n    async: \"libuv\"\n    fpu: true\n    bits: 64\n    usize: \"u64\"\n    defaultNumber: \"f64\"\n    unaligned_access: true\n    os: true\n    posix: true\n    strtoll: true\n}\n",
    "tsc.package.json": "{\n  \"name\": \"@tsclang/desktop\",\n  \"version\": \"0.1.0\",\n  \"type\": \"platform\",\n  \"description\": \"Desktop reference platform: system gcc build-and-run (cmake/make for the cmake flow)\",\n  \"platform\": {\n    \"profile\": \"desktop\",\n    \"builds\": {\n      \"desktop\": { \"profile\": \"desktop\", \"emit\": \"exec\", \"outDir\": \"build/desktop\" }\n    },\n    \"scripts\": {\n      \"start\": \"tsclang build --build desktop\",\n      \"dev\": \"tsclang build --build desktop --watch\"\n    }\n  }\n}\n"
  }
}