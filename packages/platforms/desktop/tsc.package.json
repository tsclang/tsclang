{
  "name": "@tsclang/desktop",
  "version": "0.4.0",
  "type": "platform",
  "description": "Desktop reference platform: clang build-and-run (isolated clang/LLVM bundles for win/linux/macos-arm64; darwin-x64 -> Xcode CLT; #282: PATH only for pinned toolchains)",
  "platform": {
    "profile": "desktop",
    "toolchains": {
      "clang": {
        "version": "23.1.5",
        "downloads": {
          "win32-x64": {
            "url": "https://github.com/tsclang/platform-desktop/releases/download/toolchains-v2/clang-23.1.5-win32-x64.tar.gz",
            "sha256": "6b05ceb57ebabdb4d5d21385976a196eba625fa0e30e1c15b91bd3a221ed8b2b",
            "size": 186
          },
          "linux-x64": {
            "url": "https://github.com/tsclang/platform-desktop/releases/download/toolchains-v2/clang-23.1.5-linux-x64.tar.xz",
            "sha256": "4ab196902dde81bc42137fbc61b045106370d22fb7511a13072c316bb80c9e3e",
            "size": 1999
          },
          "darwin-arm64": {
            "url": "https://github.com/tsclang/platform-desktop/releases/download/toolchains-v2/clang-23.1.5-darwin-arm64.tar.xz",
            "sha256": "61241aba35cbec918eb690870b6a65659d5fc2f0c37a5e2fb1abb5268afc5ddf",
            "size": 1553
          }
        }
      }
    },
    "builds": {
      "desktop": { "profile": "desktop", "emit": "exec", "outDir": "build/desktop" }
    },
    "scripts": {
      "start": "tsclang build --build desktop",
      "dev": "tsclang build --build desktop --watch"
    }
  }
}
