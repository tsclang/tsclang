@heap
class Box { value: i32; }
function make(shouldThrow: boolean): void throws Error {
    const b = new Box();
    b.value = 42;
    if (shouldThrow) {
        throw new Error("oops");
    }
}
function main(): i32 {
    try {
        make(true);
    } catch (e: Error) {
        return 1;
    }
    return 0;
}
console.log(main());
