// [R] weak upgrade returns null after strong ref dropped by scope exit
class Data { value: i32; }
let w: Weak<Data>;
{
    let d = new Arc<Data>();
    d.value = 42;
    w = new Weak<Data>(d);
}
let strong = w.upgrade();
if (strong != null) {
    console.log("BUG");
} else {
    console.log("safe");
}
