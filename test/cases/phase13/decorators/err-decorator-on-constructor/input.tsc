decorator function log(desc: MethodDesc): MethodDesc {
    desc.before(() => {
        console.log("before");
    });
    desc.after(() => {
        console.log("after");
    });
    return desc;
}
class Foo {
    x: i32;
    @log
    constructor(x: i32) {
        this.x = x;
    }
}
const f = new Foo(42);
console.log(f.x);
