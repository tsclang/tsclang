function check(val: unknown): void {
    if (typeof val === "i32") {
        console.log(val + 1);
    }
    if (typeof val === "string") {
        console.log(val.toUpperCase());
    }
    if (typeof val === "f64") {
        console.log(val * 2);
    }
}
let a: i32 = 42;
check(a);
check("hello");
check(3.14);
