class IOError extends Error {
    constructor(msg: string) { super(msg); }
}

function inner(a: i32, b: i32): i32 throws MathError {
    return a + b;
}

function outer(a: i32, b: i32): i32 throws MathError | IOError {
    return inner(a, b);
}

let z: i32 = 0;
let r = outer(1, 2);
if (!r.ok) {
    z = -1;
} else {
    z = r.value;
}
console.log(z);
